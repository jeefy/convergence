---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ .Namespace }}
---
apiVersion: v1
kind: Secret
metadata:
  name: stand-in
  namespace: {{ .Namespace }}
type: Opaque
stringData:
  salt: "{{ .StandinSalt }}"
{{- if eq .Provider "copilot" }}
---
apiVersion: v1
kind: Secret
metadata:
  name: convergence-copilot
  namespace: {{ .Namespace }}
type: Opaque
stringData:
  GH_COPILOT_TOKEN: "{{ .CopilotToken }}"
{{- end }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: agentgateway-config
  namespace: {{ .Namespace }}
data:
  config.yaml: |
    config:
      statsAddr: 0.0.0.0:15020
      connectionTerminationDeadline: 600s
      logging:
        format: json
    gateways:
      default:
        port: 3000
        extProc:
          conditional:
            - condition: 'request.method == "POST" && !request.path.endsWith("/embeddings")'
              host: "stand-in.{{ .Namespace }}.svc.cluster.local:9101"
              failureMode: failOpen
              processingOptions:
                requestHeaderMode: send
                responseHeaderMode: send
                requestBodyMode: fullDuplexStreamed
                responseBodyMode: fullDuplexStreamed
                requestTrailerMode: send
                responseTrailerMode: send
              policies:
                http: {requestTimeout: 5s}
    llm:
      policies:
        timeout:
          responseIdleTimeout: 120s
        extAuthz:
          conditional:
            - condition: 'request.method == "POST" && json(request.body).model in ["auto", "pinball"]'
              host: "pinball.{{ .Namespace }}.svc.cluster.local:9201"
              failureMode: allow
              includeRequestBody: {maxRequestBytes: 16777216}
              includeRequestHeaders: [content-type, x-pinball-tier, x-pinball-min-tier, x-agw-caller]
              protocol:
                http:
                  path: '"/check"'
                  metadata:
                    model: 'json(response.body).model'
                    tier: 'json(response.body).tier'
                    reason: 'json(response.body).reason'
      providers:
{{- if eq .Provider "copilot" }}
        - name: copilot-completions
          provider:
            custom:
              providerOverride: openai
              formats:
                - {type: completions, path: /v1/chat/completions}
          params:
            baseUrl: http://copilot-api.{{ .Namespace }}.svc.cluster.local:4141/v1
            apiKey: dummy
{{- else }}
        - name: openai-direct
          provider: openAI
          params:
            apiKey: "{{ .OpenAIKey }}"
        - name: anthropic-direct
          provider: anthropic
          params:
            apiKey: "{{ .AnthropicKey }}"
{{- end }}
      virtualModels:
        - name: auto
          routing: &pinball_routing
            conditional:
              targets:
                - {when: 'default(extauthz.model, "") == "claude-haiku-5.5"', model: pinball-claude-haiku-5.5}
                - {when: 'default(extauthz.model, "") == "gemini-3.8-flash"', model: pinball-gemini-3.8-flash}
                - {when: 'default(extauthz.model, "") == "claude-sonnet-5.5"', model: pinball-claude-sonnet-5.5}
                - {when: 'default(extauthz.model, "") == "claude-opus-5.5"', model: pinball-claude-opus-5.5}
                - {model: pinball-claude-sonnet-5.5}
        - name: pinball
          routing: *pinball_routing
      models:
        - name: pinball-claude-haiku-5.5
          visibility: internal
{{- if eq .Provider "copilot" }}
          provider: {reference: copilot-completions}
          params: {model: claude-haiku-5.5}
{{- else }}
          provider: {reference: anthropic-direct}
          params: {model: claude-3-5-haiku-latest}
{{- end }}
        - name: pinball-gemini-3.8-flash
          visibility: internal
{{- if eq .Provider "copilot" }}
          provider: {reference: copilot-completions}
          params: {model: gemini-3.8-flash}
{{- else }}
          provider: {reference: openai-direct}
          params: {model: gpt-4o-mini}
{{- end }}
        - name: pinball-claude-sonnet-5.5
          visibility: internal
{{- if eq .Provider "copilot" }}
          provider: {reference: copilot-completions}
          params: {model: claude-sonnet-5.5}
{{- else }}
          provider: {reference: anthropic-direct}
          params: {model: claude-3-5-sonnet-latest}
{{- end }}
        - name: pinball-claude-opus-5.5
          visibility: internal
{{- if eq .Provider "copilot" }}
          provider: {reference: copilot-completions}
          params: {model: claude-opus-5.5}
{{- else }}
          provider: {reference: anthropic-direct}
          params: {model: claude-3-opus-latest}
{{- end }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: agentgateway
  namespace: {{ .Namespace }}
spec:
  replicas: 2
  selector:
    matchLabels:
      app: agentgateway
  template:
    metadata:
      labels:
        app: agentgateway
    spec:
      containers:
        - name: agentgateway
          image: cr.agentgateway.dev/agentgateway:v1.6.0
          command: ["-f", "/etc/agentgateway/config.yaml"]
          ports:
            - containerPort: 3000
              name: http
            - containerPort: 15020
              name: stats
          volumeMounts:
            - name: config
              mountPath: /etc/agentgateway
      volumes:
        - name: config
          configMap:
            name: agentgateway-config
---
apiVersion: v1
kind: Service
metadata:
  name: agentgateway
  namespace: {{ .Namespace }}
spec:
  selector:
    app: agentgateway
  ports:
    - name: http
      port: 3000
      targetPort: 3000
    - name: stats
      port: 15020
      targetPort: 15020
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: stand-in
  namespace: {{ .Namespace }}
spec:
  replicas: 2
  selector:
    matchLabels:
      app: stand-in
  template:
    metadata:
      labels:
        app: stand-in
    spec:
      containers:
        - name: stand-in
          image: ghcr.io/jeefy/stand-in:0.4.1
          env:
            - name: STANDIN_MODE
              value: "enforce"
            - name: STANDIN_SALT
              valueFrom:
                secretKeyRef:
                  name: stand-in
                  key: salt
          ports:
            - containerPort: 9101
              name: grpc
            - containerPort: 9102
              name: metrics
---
apiVersion: v1
kind: Service
metadata:
  name: stand-in
  namespace: {{ .Namespace }}
spec:
  selector:
    app: stand-in
  ports:
    - name: grpc
      port: 9101
      targetPort: 9101
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: pinball
  namespace: {{ .Namespace }}
spec:
  replicas: 2
  selector:
    matchLabels:
      app: pinball
  template:
    metadata:
      labels:
        app: pinball
    spec:
      containers:
        - name: pinball
          image: ghcr.io/jeefy/pinball:0.7.2
          ports:
            - containerPort: 9201
              name: http
---
apiVersion: v1
kind: Service
metadata:
  name: pinball
  namespace: {{ .Namespace }}
spec:
  selector:
    app: pinball
  ports:
    - name: http
      port: 9201
      targetPort: 9201
{{- if eq .Provider "copilot" }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: copilot-api
  namespace: {{ .Namespace }}
spec:
  replicas: 2
  selector:
    matchLabels:
      app: copilot-api
  template:
    metadata:
      labels:
        app: copilot-api
    spec:
      containers:
        - name: copilot-api
          image: ghcr.io/ericc-ch/copilot-api:v0.1.25
          env:
            - name: COPILOT_TOKEN
              valueFrom:
                secretKeyRef:
                  name: convergence-copilot
                  key: GH_COPILOT_TOKEN
          ports:
            - containerPort: 4141
              name: http
---
apiVersion: v1
kind: Service
metadata:
  name: copilot-api
  namespace: {{ .Namespace }}
spec:
  selector:
    app: copilot-api
  ports:
    - name: http
      port: 4141
      targetPort: 4141
{{- end }}
