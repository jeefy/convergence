# Rendered by convergence. Contains NO secrets: they live in the 0600 .env file
# next to this one and are injected via ${VAR} interpolation.
name: convergence

services:
  agentgateway:
    image: {{ .Images.AgentGateway }}
    command: ["-f", "/etc/agentgateway/agentgateway.yaml"]
    restart: unless-stopped
{{- if or (eq .Config.Provider "direct") .Config.RequestLogDB }}
    environment:
{{- if eq .Config.Provider "direct" }}
      OPENAI_API_KEY: ${OPENAI_API_KEY:-}
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY:-}
{{- end }}
{{- if .Config.RequestLogDB }}
      REQUEST_LOG_DB_URL: ${REQUEST_LOG_DB_URL:?REQUEST_LOG_DB_URL missing from .env; run convergence init}
{{- end }}
{{- end }}
    ports:
      - "{{ .Config.BindAddress }}:{{ .Config.GatewayPort }}:3000"
      - "{{ .Config.BindAddress }}:{{ .Ports.GatewayStats }}:15020"
    volumes:
      - ./agentgateway.yaml:/etc/agentgateway/agentgateway.yaml:ro{{ .VolumeSuffix }}
    extra_hosts:
      - "host.docker.internal:host-gateway"
    # No healthcheck for agentgateway itself: the image is distroless (no
    # shell, wget or curl). `convergence status` probes it over its port.
    depends_on:
      stand-in:
        condition: service_started
      pinball:
        condition: service_healthy{{ if eq .Config.Provider "copilot" }}
      copilot-api:
        condition: service_healthy{{ end }}
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  stand-in:
    image: {{ .Images.StandIn }}
    restart: unless-stopped
    environment:
      STANDIN_MODE: enforce
      STANDIN_SALT: ${STANDIN_SALT:?STANDIN_SALT missing from .env; run convergence init}
      STANDIN_GRPC_PORT: "9101"
      STANDIN_METRICS_PORT: "9102"
    ports:
      - "{{ .Config.BindAddress }}:{{ .Ports.StandinMetrics }}:9102"
    # Distroless image (no shell or python3); `convergence status` probes :9102 over loopback HTTP.
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  pinball:
    image: {{ .Images.Pinball }}
    restart: unless-stopped
    volumes:
      - ./pinball.yaml:/etc/pinball/pinball.yaml:ro{{ .VolumeSuffix }}
    ports:
      - "{{ .Config.BindAddress }}:{{ .Ports.Pinball }}:9201"
    healthcheck:
      test: ["CMD", "python3", "-c", "__import__('urllib.request').request.urlopen('http://127.0.0.1:9201/healthz',timeout=3)"]
      interval: 5s
      timeout: 5s
      retries: 12
      start_period: 5s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
{{- if eq .Config.Provider "copilot" }}

  copilot-api:
    # ericc-ch/copilot-api: entrypoint runs `start -g "$GH_TOKEN"`; GH_TOKEN is a
    # GitHub OAuth token from `convergence login copilot` (verified on v0.7.0).
    image: {{ .Images.CopilotAPI }}
    restart: unless-stopped
    environment:
      GH_TOKEN: ${GH_TOKEN:?GH_TOKEN missing from .env; run convergence login copilot}
    volumes:
      - copilot-data:/root/.local/share/copilot-api
      # Disable Bun's 10s idleTimeout (cuts long streams); see copilot-api-idle-timeout.js.
      - ./copilot-api-idle-timeout.js:/etc/copilot-api/idle-timeout.js:ro{{ .VolumeSuffix }}
      - ./copilot-api-bunfig.toml:/app/bunfig.toml:ro{{ .VolumeSuffix }}
    ports:
      - "{{ .Config.BindAddress }}:{{ .Ports.CopilotAPI }}:4141"
    # busybox wget exists in this image; "/" answers 200 once the server is up.
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:4141/"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 15s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  copilot-data:
{{- end }}
{{- if eq .Config.Sandbox "openshell" }}

  openshell:
    image: {{ .Images.OpenShellGateway }}
    restart: unless-stopped
    command: []
    user: "0"
    ports:
      - "{{ .Config.BindAddress }}:{{ .Ports.OpenShell }}:17670"
      - "{{ .Config.BindAddress }}:{{ .Ports.OpenShellHealth }}:17671"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - openshell-data:/var/lib/openshell
      - ./openshell.toml:/etc/openshell/gateway.toml:ro{{ .VolumeSuffix }}
    environment:
      OPENSHELL_GATEWAY_CONFIG: /etc/openshell/gateway.toml
      OPENSHELL_DB_URL: "sqlite:/var/lib/openshell/gateway.db?mode=rwc"
      XDG_DATA_HOME: /var/lib/openshell
      XDG_STATE_HOME: /var/lib/openshell/state
      HOME: /var/lib/openshell
    extra_hosts:
      - "host.docker.internal:host-gateway"
      - "host.openshell.internal:host-gateway"
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  openshell-data:
{{- end }}
