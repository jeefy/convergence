# Rendered by convergence. Contains NO secrets: they live in the 0600 .env file
# next to this one and are injected via ${VAR} interpolation.
name: convergence

services:
  agentgateway:
    image: {{ .Images.AgentGateway }}
    command: ["-f", "/etc/agentgateway/agentgateway.yaml"]
    restart: unless-stopped
{{- if eq .Config.Provider "direct" }}
    environment:
      OPENAI_API_KEY: ${OPENAI_API_KEY:-}
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY:-}
{{- end }}
    ports:
      - "{{ .Config.BindAddress }}:{{ .Config.GatewayPort }}:3000"
      - "{{ .Config.BindAddress }}:{{ .Ports.GatewayStats }}:15020"
    volumes:
      - ./agentgateway.yaml:/etc/agentgateway/agentgateway.yaml:ro{{ .VolumeSuffix }}
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
      - stand-in
      - pinball{{ if eq .Config.Provider "copilot" }}
      - copilot-api{{ end }}

  stand-in:
    image: {{ .Images.StandIn }}
    restart: unless-stopped
    environment:
      STANDIN_MODE: enforce
      STANDIN_SALT: ${STANDIN_SALT:?STANDIN_SALT missing from .env; run convergence init}
      STANDIN_GRPC_PORT: "9101"
      STANDIN_METRICS_PORT: "9102"
    ports:
      - "{{ .Config.BindAddress }}:{{ .Ports.StandinMetrics }}:9102"

  pinball:
    image: {{ .Images.Pinball }}
    restart: unless-stopped
    volumes:
      - ./pinball.yaml:/etc/pinball/pinball.yaml:ro{{ .VolumeSuffix }}
    ports:
      - "{{ .Config.BindAddress }}:{{ .Ports.Pinball }}:9201"
{{- if eq .Config.Provider "copilot" }}

  copilot-api:
    # ericc-ch/copilot-api: entrypoint runs `start -g "$GH_TOKEN"`; GH_TOKEN is a
    # GitHub OAuth token from `convergence login copilot` (verified on v0.7.0).
    image: {{ .Images.CopilotAPI }}
    restart: unless-stopped
    environment:
      GH_TOKEN: ${GH_TOKEN:?GH_TOKEN missing from .env; run convergence login copilot}
    volumes:
      - copilot-data:/root/.local/share/copilot-api
    ports:
      - "{{ .Config.BindAddress }}:{{ .Ports.CopilotAPI }}:4141"

volumes:
  copilot-data:
{{- end }}
