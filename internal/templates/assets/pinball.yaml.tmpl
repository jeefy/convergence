# Schema of ghcr.io/jeefy/pinball:0.7.2. Generated from internal/models
# (override upstream mapping in ~/.convergence/models.yaml).
models:
{{- range .Models.Models }}
  {{ .PinballName }}: {prompt_tokens: {{ .PromptTokens }}}
{{- end }}
tiers:
  light: [{{ .Models.TierList "light" }}]
  standard: [{{ .Models.TierList "standard" }}]
  heavy: [{{ .Models.TierList "heavy" }}]
thresholds:
  standard: {{ .Models.Thresholds.Standard }}
  heavy: {{ .Models.Thresholds.Heavy }}
