# Rendered by convergence. OpenShell Gateway configuration (Schema version 2).
[openshell]
version = 2

[openshell.gateway]
bind_address = "0.0.0.0:17670"
health_bind_address = "0.0.0.0:17671"
log_level = "info"
disable_tls = true
compute_driver = "{{ .OpenShellDriver }}"

[openshell.gateway.auth]
allow_unauthenticated_users = true

[openshell.drivers.{{ .OpenShellDriver }}]
socket_path = "/var/run/docker.sock"
default_image = "ghcr.io/nvidia/openshell-community/sandboxes/base:latest"
supervisor_image = "ghcr.io/nvidia/openshell/supervisor:latest"
image_pull_policy = "if_not_present"
{{- if eq .OpenShellDriver "docker" }}
sandbox_label = "openshell"
{{- end }}
