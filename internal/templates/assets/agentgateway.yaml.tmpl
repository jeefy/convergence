# Rendered by convergence. Contains NO secrets: provider API keys are read by
# agentgateway from its environment (env interpolation, verified against
# agentgateway v1.6.0), which compose fills from the 0600 .env file.
config:
  statsAddr: 0.0.0.0:15020
  connectionTerminationDeadline: 600s
  logging:
    format: json

gateways:
  default:
    port: 3000
    extProc:
      conditional:
        - condition: 'request.method == "POST" && !request.path.endsWith("/embeddings")'
          host: "stand-in:9101"
          # failClosed (default): Stand-In down => request rejected, nothing
          # unscrubbed leaves. failOpen only with `init --fail-open`.
          failureMode: {{ if .Config.FailOpen }}failOpen{{ else }}failClosed{{ end }}
          processingOptions:
            requestHeaderMode: send
            responseHeaderMode: send
            requestBodyMode: fullDuplexStreamed
            responseBodyMode: fullDuplexStreamed
            requestTrailerMode: send
            responseTrailerMode: send
          policies:
            http: {requestTimeout: 5s}

llm:
  policies:
    timeout:
      responseIdleTimeout: 120s
    extAuthz:
      conditional:
        - condition: 'request.method == "POST" && json(request.body).model in ["auto", "pinball"]'
          host: "pinball:9201"
          # allow on purpose: if Pinball is down the request routes to the
          # fallback target. That only affects model choice, never confidentiality
          # (scrubbing is the ext_proc above).
          failureMode: allow
          includeRequestBody: {maxRequestBytes: 16777216}
          includeRequestHeaders: [content-type, x-pinball-tier, x-pinball-min-tier, x-agw-caller]
          protocol:
            http:
              path: '"/check"'
              metadata:
                model: 'json(response.body).model'
                tier: 'json(response.body).tier'
                reason: 'json(response.body).reason'

  providers:
{{- if eq .Config.Provider "copilot" }}
    - name: copilot-completions
      provider:
        custom:
          providerOverride: openai
          formats:
            - {type: completions, path: /v1/chat/completions}
      params:
        baseUrl: http://copilot-api:4141/v1
        apiKey: dummy
{{- else if eq .Config.Provider "ollama" }}
    - name: ollama-local
      provider: ollama
      params:
        baseUrl: {{ .Config.OllamaURL }}
{{- else }}
{{- if .Models.UsesFamily "openai" }}
    - name: openai-direct
      provider: openAI
      params:
        apiKey: "$OPENAI_API_KEY"
{{- end }}
{{- if .Models.UsesFamily "anthropic" }}
    - name: anthropic-direct
      provider: anthropic
      params:
        apiKey: "$ANTHROPIC_API_KEY"
{{- end }}
{{- end }}

  # Generated from internal/models (override: ~/.convergence/models.yaml).
  virtualModels:
    - name: auto
      routing: &pinball_routing
        conditional:
          targets:
{{- range .Models.Models }}
            - {when: 'default(extauthz.model, "") == "{{ .PinballName }}"', model: pinball-{{ .PinballName }}}
{{- end }}
            - {model: pinball-{{ .Models.Fallback }}}
    - name: pinball
      routing: *pinball_routing

  models:
{{- range .Models.Models }}
    - name: pinball-{{ .PinballName }}
      visibility: internal
      provider: {reference: {{ providerRef .UpstreamProvider }}}
      params: {model: {{ .UpstreamModel }}}
{{ end }}