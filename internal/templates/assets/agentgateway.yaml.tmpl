config:
  statsAddr: 0.0.0.0:15020
  connectionTerminationDeadline: 600s
  accessLog:
    file:
      path: /var/log/agentgateway/access.jsonl
      format: json

gateways:
  default:
    port: 3000
    protocol: HTTP
    extProc: &standin_enforce
      grpcService:
        endpoint: stand-in:9101
      mode:
        requestHeader: SEND
        requestBody: FULL_DUPLEX_STREAMED
        responseHeader: SEND
        responseBody: FULL_DUPLEX_STREAMED
      failureMode: FAIL_OPEN
      timeout: 5s

llm:
  policies:
    timeout:
      responseIdleTimeout: 120s
    extAuthz:
      httpService:
        endpoint: http://pinball:9201/check
        failureMode: ALLOW
        timeout: 2s
      condition: 'json(request.body).model in ["auto", "pinball"]'

  providers:
{{- if eq .Config.Provider "copilot" }}
    copilot-proxy:
      type: openai
      baseUrl: http://copilot-api:4141/v1
{{- else if eq .Config.Provider "ollama" }}
    ollama-local:
      type: ollama
      baseUrl: {{ .Config.OllamaURL }}
{{- else }}
    openai:
      type: openai
      apiKey: "{{ .Config.OpenAIKey }}"
    anthropic:
      type: anthropic
      apiKey: "{{ .Config.AnthropicKey }}"
{{- end }}

  virtualModels:
    auto:
      routing:
        header: extauthz.model
        fallback: pinball-claude-sonnet-5.5
        targets:
          claude-haiku-5.5: pinball-claude-haiku-5.5
          gemini-3.8-flash: pinball-gemini-3.8-flash
          claude-sonnet-5.5: pinball-claude-sonnet-5.5
          claude-opus-5.5: pinball-claude-opus-5.5

  models:
    pinball-claude-haiku-5.5:
      visibility: internal
{{- if eq .Config.Provider "copilot" }}
      provider: copilot-proxy
      model: claude-haiku-5.5
{{- else if eq .Config.Provider "ollama" }}
      provider: ollama-local
      model: qwen2.5-coder:7b
{{- else }}
      provider: anthropic
      model: claude-3-5-haiku-latest
{{- end }}

    pinball-gemini-3.8-flash:
      visibility: internal
{{- if eq .Config.Provider "copilot" }}
      provider: copilot-proxy
      model: gemini-3.8-flash
{{- else if eq .Config.Provider "ollama" }}
      provider: ollama-local
      model: llama3.2:latest
{{- else }}
      provider: openai
      model: gpt-4o-mini
{{- end }}

    pinball-claude-sonnet-5.5:
      visibility: internal
{{- if eq .Config.Provider "copilot" }}
      provider: copilot-proxy
      model: claude-sonnet-5.5
{{- else if eq .Config.Provider "ollama" }}
      provider: ollama-local
      model: qwen2.5-coder:14b
{{- else }}
      provider: anthropic
      model: claude-3-5-sonnet-latest
{{- end }}

    pinball-claude-opus-5.5:
      visibility: internal
{{- if eq .Config.Provider "copilot" }}
      provider: copilot-proxy
      model: claude-opus-5.5
{{- else if eq .Config.Provider "ollama" }}
      provider: ollama-local
      model: qwen2.5-coder:32b
{{- else }}
      provider: anthropic
      model: claude-3-opus-latest
{{- end }}
