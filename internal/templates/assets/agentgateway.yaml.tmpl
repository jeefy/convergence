# Rendered by convergence. Contains NO secrets: provider API keys are read by
# agentgateway from its environment (env interpolation, verified against
# agentgateway v1.6.0), which compose fills from the 0600 .env file.
config:
  statsAddr: 0.0.0.0:15020
  connectionTerminationDeadline: 600s
{{- if .Config.RequestLogDB }}
  # request_logs.agentgateway_user: the caller a client names in x-agw-caller.
  # Pinball's optimizer (per-caller results, eval-* exclusion) and insights read it.
  standardAttributes:
    user: 'default(request.headers["x-agw-caller"], null)'
{{- end }}
  logging:
    format: json
{{- if .Config.RequestLogDB }}
    # Opt-in request log for `convergence optimize` (init --request-log-db).
    database:
      url: "$REQUEST_LOG_DB_URL"
{{- end }}

# accessLog.add lets pinball-optimize find routed requests (attributes_json->>'pinball.tier').
frontendPolicies:
  accessLog:
    add:
      pinball.model: 'default(extauthz.model, null)'
      pinball.tier: 'default(extauthz.tier, null)'
      pinball.reason: 'default(extauthz.reason, null)'
      pinball.score: 'default(extauthz.score, null)'
      pinball.est_tokens: 'default(extauthz.est_tokens, null)'
{{- if .Config.RequestLogDB }}
    # full stores prompts and completions (after Stand-In scrubbing); the
    # optimizer replays them.
    database:
      llm: full
{{- end }}
{{- if .Config.OTel.Enabled }}
  tracing:
    host: {{ .Config.OTel.Endpoint }}
    protocol: {{ .Config.OTel.ProtocolOrDefault }}
    randomSampling: {{ .Config.OTel.SampleOrDefault }}
    resources:
      service.name: '"convergence"'
    attributes:
      caller: 'default(request.headers["x-agw-caller"], "")'
      pinball.tier: 'default(extauthz.tier, "")'
      pinball.model: 'default(extauthz.model, "")'
      pinball.reason: 'default(extauthz.reason, "")'
      pinball.score: 'default(string(extauthz.score), "")'
{{- end }}

gateways:
  default:
    port: 3000
    extProc:
      conditional:
        - condition: 'request.method == "POST" && !request.path.endsWith("/embeddings")'
          host: "stand-in:9101"
          # failClosed (default): Stand-In down => request rejected, nothing
          # unscrubbed leaves. failOpen only with `init --fail-open`.
          failureMode: {{ if .Config.FailOpen }}failOpen{{ else }}failClosed{{ end }}
          processingOptions:
            requestHeaderMode: send
            responseHeaderMode: send
            requestBodyMode: fullDuplexStreamed
            responseBodyMode: fullDuplexStreamed
            requestTrailerMode: send
            responseTrailerMode: send
          policies:
            http: {requestTimeout: {{ .Config.ExtProcTimeoutValue }}}

llm:
  policies:
    timeout:
      responseIdleTimeout: 120s
    transformations:
      response:
        set:
          # Surface Pinball's pick to clients: with model=auto the body says the real model, which
          # clients report as a "route change". Absent when Pinball did not run (explicit model).
          x-pinball-model: 'default(extauthz.model, "")'
          x-pinball-tier: 'default(extauthz.tier, "")'
          x-pinball-reason: 'default(extauthz.reason, "")'
    extAuthz:
      conditional:
        - condition: 'request.method == "POST" && json(request.body).model in ["auto", "pinball"]'
          host: "pinball:9201"
          # allow on purpose: if Pinball is down the request routes to the
          # fallback target. That only affects model choice, never confidentiality
          # (scrubbing is the ext_proc above).
          failureMode: allow
          includeRequestBody: {maxRequestBytes: 16777216}
          includeRequestHeaders: [content-type, x-pinball-tier, x-pinball-min-tier, x-agw-caller]
          protocol:
            http:
              path: '"/check"'
              metadata:
                model: 'json(response.body).model'
                tier: 'json(response.body).tier'
                reason: 'json(response.body).reason'
                score: 'json(response.body).score'
                est_tokens: 'json(response.body).est_tokens'

  providers:
{{- if or (eq .Config.Provider "copilot") (.Models.UsesFamily "copilot") }}
    - name: copilot-completions
      provider:
        custom:
          providerOverride: copilot
          formats:
            - {type: completions, path: /v1/chat/completions}
      params:
        baseUrl: http://copilot-api:4141/v1
        apiKey: dummy
{{- end }}
{{- if or (eq .Config.Provider "ollama") (.Models.UsesFamily "ollama") }}
    - name: ollama-local
      provider: ollama
      params:
        baseUrl: {{ .Config.OllamaURL }}
{{- end }}
{{- if .Models.UsesFamily "openai" }}
    - name: openai-direct
      provider: openAI
      params:
        apiKey: "$OPENAI_API_KEY"
{{- end }}
{{- if .Models.UsesFamily "anthropic" }}
    - name: anthropic-direct
      provider: anthropic
      params:
        apiKey: "$ANTHROPIC_API_KEY"
{{- end }}

{{- range .Models.Endpoints }}
    - name: {{ .Endpoint }}
      provider: {{ if eq .Provider "openai" }}openAI{{ else }}{{ .Provider }}{{ end }}
      params:
{{- if .BaseURL }}
        baseUrl: {{ .BaseURL }}
{{- end }}
{{- if .KeyEnv }}
        apiKey: "${{ "{" }}{{ .KeyEnv }}{{ "}" }}"
{{- end }}
{{- end }}

  # Generated from internal/models (override: ~/.convergence/models.yaml).
  virtualModels:
    - name: auto
      routing: &pinball_routing
        conditional:
          targets:
{{- range .Models.Models }}
            - {when: 'default(extauthz.model, "") == "{{ .PinballName }}"', model: pinball-{{ .PinballName }}}
{{- end }}
{{- if .Config.DiscoverModels }}
            - {when: 'default(extauthz.model, "") != ""', model: pinball-live}
{{- end }}
            - {model: pinball-{{ .Models.Fallback }}}
    - name: pinball
      routing: *pinball_routing
    - name: light
      routing:
        conditional:
          targets:
            - {model: pinball-{{ .Models.TierModel "light" }}}
    - name: standard
      routing:
        conditional:
          targets:
            - {model: pinball-{{ .Models.TierModel "standard" }}}
    - name: heavy
      routing:
        conditional:
          targets:
            - {model: pinball-{{ .Models.TierModel "heavy" }}}

{{- define "copilotSystem" }}
      finalTransformation:
        messages: |-
          llmRequest.messages.map(m, m.role in ["system", "developer"] && has(m.content) && m.content != null ? {"role": "system", "content": type(m.content) == string ? m.content : m.content.filter(p, has(p.text)).map(p, p.text).join("\n\n")} : m)
{{- end }}

  # system_prompt in config.yaml: a CEL request transformation on the served
  # models prepends the configured text (OpenAI chat, Responses and Anthropic Messages).
  #
  # Copilot models carry a finalTransformation on the converted chat completions
  # body: Copilot ignores, for Claude models, a system message whose content is a
  # list of parts (how Anthropic system blocks are converted) and the developer
  # role (how Responses instructions are converted). Both become one plain-text
  # system message.
  models:
{{- range .Models.Models }}
    - name: pinball-{{ .PinballName }}
      visibility: internal
      provider: {reference: {{ providerRef .UpstreamProvider }}}
      params: {model: {{ .UpstreamModel }}}
{{- if eq (providerRef .UpstreamProvider) "copilot-completions" }}{{ template "copilotSystem" }}{{ end }}
{{- with $.Config.SystemPrompt.YAMLTransformation 6 }}
{{ . }}
{{- end }}
{{- end }}
{{- if .Config.RequestLogDB }}
    # Public twins of the internal pinball-<id> models for `convergence optimize`
    # candidate replays (PINBALL_OPT_MODEL_PREFIX=opt-).
    # No system_prompt transformation here: replays are built from the request
    # log, which already holds the prepended prompt.
{{- range .Models.Models }}
{{- /* with discover_models, "opt-*" already serves a twin whose name is its upstream id */}}
{{- if not (and $.Config.DiscoverModels (eq .PinballName .UpstreamModel) (eq .UpstreamProvider (printf "%s" $.Config.Provider))) }}
    - name: opt-{{ .PinballName }}
      provider: {reference: {{ providerRef .UpstreamProvider }}}
      params: {model: {{ .UpstreamModel }}}
{{- if eq (providerRef .UpstreamProvider) "copilot-completions" }}{{ template "copilotSystem" }}{{ end }}
{{- end }}
{{- end }}
{{- end }}
{{- range .Models.Passthrough }}
    - name: {{ .Name }}
      provider: {reference: {{ if .Endpoint }}{{ .Endpoint }}{{ else }}{{ providerRef .Provider }}{{ end }}}
      params: {model: {{ .Model }}}
{{- if and (not .Endpoint) (eq (providerRef .Provider) "copilot-completions") }}{{ template "copilotSystem" }}{{ end }}
{{- with $.Config.SystemPrompt.YAMLTransformation 6 }}
{{ . }}
{{- end }}
{{- end }}
{{- if .Config.DiscoverModels }}
{{- $ref := "ollama-local" }}{{ if eq .Config.Provider "copilot" }}{{ $ref = "copilot-completions" }}{{ end }}
    # discover_models: Pinball picks an id from the upstream's model list; it
    # is sent upstream as is. Other ids go to the upstream unchanged.
    - name: pinball-live
      visibility: internal
      provider: {reference: {{ $ref }}}
{{- if eq $ref "copilot-completions" }}{{ template "copilotSystem" }}{{ end }}
{{- with $.Config.SystemPrompt.YAMLTransformationModel 6 "default(extauthz.model, llmRequest.model)" }}
{{ . }}
{{- end }}
{{- if .Config.RequestLogDB }}
    - name: "opt-*"
      provider: {reference: {{ $ref }}}
{{- if eq $ref "copilot-completions" }}{{ template "copilotSystem" }}{{ end }}
      transformation:
        # substring, not stripPrefix: agentgateway cannot reverse it, so
        # /v1/models lists one "opt-*" entry instead of a twin of every model.
        model: 'llmRequest.model.substring(4)'
{{- end }}
    - name: "*"
      provider: {reference: {{ $ref }}}
{{- if eq $ref "copilot-completions" }}{{ template "copilotSystem" }}{{ end }}
{{- with $.Config.SystemPrompt.YAMLTransformation 6 }}
{{ . }}
{{- end }}
{{- end }}
